# Copier ce fichier en .env et renseigner les valeurs.
# Le fichier .env n'est pas versionné.

POSTGRES_PASSWORD=

# SQL Server : au moins 8 caractères, pris dans trois familles parmi
# majuscules, minuscules, chiffres et symboles.
MSSQL_SA_PASSWORD=

# Mot de passe du compte « chronos_app », avec lequel l'API se connecte (lecture et écriture des lignes, aucun
# droit sur le schéma). Créé avec la base : à définir avant le premier démarrage.
POSTGRES_APP_PASSWORD=

# Adresse du premier administrateur de l'application (profil app). Son mot de passe n'est pas ici : créez le
# fichier secrets/administrateur-mot-de-passe.txt, non versionné, qui ne contient que ce mot de passe.
ADMIN_EMAIL=
