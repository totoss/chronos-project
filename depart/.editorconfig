root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,xml,csproj,props,slnx,html,scss,ts}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

